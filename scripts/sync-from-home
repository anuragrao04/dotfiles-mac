#!/usr/bin/env bash
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo"
copy_file() { mkdir -p "$(dirname "$2")"; cp "$1" "$2"; }
copy_dir() { mkdir -p "$2"; rsync -a --delete "$1/" "$2/"; }
copy_file "$HOME/.zshrc" zsh/.zshrc
copy_file "$HOME/.zprofile" zsh/.zprofile
copy_file "$HOME/.gitconfig" git/.gitconfig
copy_file "$HOME/.config/git/ignore" git/.config/git/ignore
copy_file "$HOME/.fzf.zsh" shell-tools/.fzf.zsh
copy_file "$HOME/.zoxide.zsh" shell-tools/.zoxide.zsh
copy_file "$HOME/.yarnrc" shell-tools/.yarnrc
copy_dir "$HOME/.config/fish" fish/.config/fish
copy_dir "$HOME/.config/kitty" kitty/.config/kitty
copy_dir "$HOME/.config/nvim" nvim/.config/nvim
copy_file "$HOME/.config/tmux/tmux.conf" tmux/.config/tmux/tmux.conf
copy_file "$HOME/.config/starship.toml" starship/.config/starship.toml
copy_dir "$HOME/.config/sesh" sesh/.config/sesh
copy_dir "$HOME/.config/taskell" taskell/.config/taskell
copy_file "$HOME/.config/karabiner/karabiner.json" karabiner/.config/karabiner/karabiner.json
copy_dir "$HOME/.config/karabiner/assets/complex_modifications" karabiner/.config/karabiner/assets/complex_modifications
copy_file "$HOME/.config/zed/settings.json" zed/.config/zed/settings.json
copy_file "$HOME/.config/gh/config.yml" gh/.config/gh/config.yml
copy_file "$HOME/Library/Preferences/com.raycast.macos.plist" raycast/Library/Preferences/com.raycast.macos.plist
copy_file "$HOME/.config/opencode/AGENTS.md" opencode/.config/opencode/AGENTS.md
[ -f "$HOME/.config/opencode/package.json" ] && copy_file "$HOME/.config/opencode/package.json" opencode/.config/opencode/package.json
[ -f "$HOME/.config/opencode/package-lock.json" ] && copy_file "$HOME/.config/opencode/package-lock.json" opencode/.config/opencode/package-lock.json
[ -f "$HOME/.config/opencode/bun.lock" ] && copy_file "$HOME/.config/opencode/bun.lock" opencode/.config/opencode/bun.lock
[ -d "$HOME/.config/opencode/skills" ] && copy_dir "$HOME/.config/opencode/skills" opencode/.config/opencode/skills
python3 - <<'PY'
from pathlib import Path
import re
src=Path.home()/'.config/opencode/opencode.json'
dst=Path.home()/'repos/personal/dotfiles-mac/opencode/.config/opencode/opencode.json'
s=src.read_text()
# Do not leak live MCP tokens if they reappear in the local file.
s=re.sub(r'ctx7sk-[A-Za-z0-9-]+', '${CONTEXT7_API_KEY}', s)
s=re.sub(r'cxup_[A-Za-z0-9]+', '${CORALOGIX_MCP_AUTHORIZATION}', s)
dst.write_text(s)
PY
git status --short

#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
if ! command -v stow >/dev/null 2>&1; then
  if command -v brew >/dev/null 2>&1; then
    brew install stow
  else
    echo "GNU stow not found. Install Homebrew or run: brew install stow" >&2
    exit 1
  fi
fi
backup_dir="$HOME/.dotfiles-backup-$(date +%Y%m%d-%H%M%S)"

# Raycast can immediately recreate its preferences while running, causing Stow
# conflicts even after backup. Quit it before managing its plist.
if pgrep -x Raycast >/dev/null 2>&1; then
  osascript -e 'tell application "Raycast" to quit' >/dev/null 2>&1 || true
  sleep 1
fi

conflicts=()
while IFS= read -r p; do
  rel="${p#./*/}"
  target="$HOME/$rel"
  [ -e "$target" ] || [ -L "$target" ] || continue
  if [ -L "$target" ]; then
    link_target="$(readlink "$target")"
    case "$link_target" in
      *dotfiles-mac*) continue ;;
    esac
  fi
  conflicts+=("$rel")
done < <(find zsh git shell-tools fish kitty nvim tmux starship sesh taskell karabiner zed gh opencode -type f | sed 's#^#./#')
if [ "${#conflicts[@]}" -gt 0 ]; then
  mkdir -p "$backup_dir"
  for rel in "${conflicts[@]}"; do
    mkdir -p "$backup_dir/$(dirname "$rel")"
    mv "$HOME/$rel" "$backup_dir/$rel"
  done
  echo "Backed up existing files to: $backup_dir"
fi
# Defensive second pass for Raycast: macOS/Raycast/cfprefsd may recreate this
# plist after the first backup loop.
raycast_plist="Library/Preferences/com.raycast.macos.plist"
if [ -e "$HOME/$raycast_plist" ] && [ ! -L "$HOME/$raycast_plist" ]; then
  mkdir -p "$backup_dir/Library/Preferences"
  mv "$HOME/$raycast_plist" "$backup_dir/$raycast_plist"
  killall cfprefsd >/dev/null 2>&1 || true
  echo "Backed up Raycast preferences to: $backup_dir/$raycast_plist"
fi

./scripts/stow
